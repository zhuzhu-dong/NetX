# NetPulse local deployment template
#
# Copy this file to .env and replace placeholder values only on your own machine.
# Never commit .env, API keys, passwords, access tokens, cookies, or authorization headers.
# Values below are examples/placeholders; choose values that match your deployment.

# Real LLM provider (OpenAI-compatible provider example)
LLM_PROVIDER=openai
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://example-provider-endpoint/v1
LLM_API_KEY=your-api-key-here
# Legacy provider-specific names remain supported as fallbacks.
# OPENAI_API_KEY=your-api-key-here
# DASHSCOPE_API_KEY=your-api-key-here
# WANGTIAO2026_API_KEY=your-api-key-here
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1200

# Optional application/API protection. Set a strong local value before exposing APIs.
IDN_API_KEY=placeholder-change-me-before-exposing-the-api
IDN_CORS_ORIGINS=http://localhost:5173
IDN_APP_DB_PATH=/app/data/app.db
IDN_SQLITE_BUSY_TIMEOUT_MS=5000
IDN_SQLITE_JOURNAL_MODE=WAL

# ONOS and P4Runtime endpoints. Credentials are intentionally placeholders.
ONOS_HOST=onos
ONOS_PORT=8181
ONOS_USERNAME=your-onos-username
ONOS_PASSWORD=your-onos-password
P4RUNTIME_SWITCH_HOST=mininet
P4RUNTIME_SWITCH_PORT=9559
MININET_PROBE_URL=http://mininet:9001
SERVICE_PROFILES_FILE=/app/config/service_profiles.json
TOPOLOGY_PATHS_FILE=/app/config/topology_paths.json

# Control-plane safety and execution defaults
IDN_MOCK_MODE=false
IDN_EMBEDDED_WORKER_ENABLED=true
IDN_NETWORK_RECONCILER_ENABLED=true
IDN_NETWORK_WRITE_FENCING_REQUIRED=true
IDN_QOS_ENFORCEMENT_REQUIRED=true
IDN_PRODUCTION_RESTART_RECOVERY_ENABLED=true
IDN_RECOVERY_FULL_READBACK_REQUIRED=true

# Optional autonomous features. Keep disabled unless they have been separately validated.
IDN_INTENT_ASSURANCE_ENABLED=false
IDN_PROBE_SCHEDULER_ENABLED=false
IDN_FAULT_CONTROLLER_ENABLED=false
IDN_WATCHER_ENABLED=false
IDN_LLM_STARTUP_PROBE_ENABLED=false

# Execution and verification timing (seconds unless the name states otherwise)
IDN_JOB_TIMEOUT_SECONDS=120
IDN_NODE_TIMEOUT_PARSE=30
IDN_NODE_TIMEOUT_GENERATE=30
IDN_NODE_TIMEOUT_SAFETY_COUNCIL=30
IDN_NODE_TIMEOUT_EXECUTE=60
IDN_NODE_TIMEOUT_VERIFY=60
IDN_VERIFY_EXECUTION_READBACK_TIMEOUT_SECONDS=60
ONOS_FLOW_VERIFY_TIMEOUT_SECONDS=30
ONOS_FLOW_VERIFY_INTERVAL_SECONDS=1
ONOS_COUNTER_VERIFY_TIMEOUT_SECONDS=30
PROBE_TIMEOUT=20

# QoS and measurement defaults; do not lower SLA/capacity values merely to force a pass.
IDN_QOS_LINK_CEIL_MBPS=49
IDN_QOS_DEFAULT_CLASS_RATE_MBPS=1
IDN_QOS_KPI_DURATION_SECS=3
IDN_QOS_KPI_TOLERANCE_RATIO=0.05
IDN_QOS_RATE_LIMIT_TOLERANCE_RATIO=0.05
STATUS_VERIFIER_RUN_IPERF=true

# Frontend development proxy (normally supplied by Docker Compose)
VITE_API_PROXY_TARGET=http://idn-system:8000
