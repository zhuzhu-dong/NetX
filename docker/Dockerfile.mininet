# ============================================================
# Mininet + stratum_bmv2 基础设施镜像
# 基于 ONF stratum-bmv2 Mininet 镜像, 通过 gNMI 自动发现端口
# ============================================================
FROM opennetworking/mn-stratum:latest

# ── iperf3（buster EOL, 改用 archive.debian.org） ──
RUN printf 'deb http://archive.debian.org/debian buster main\n' \
         'deb http://archive.debian.org/debian-security buster/updates main\n' \
         > /etc/apt/sources.list \
    && apt-get update -o Acquire::Check-Valid-Until=false -qq \
    && apt-get install -y -qq iperf3 python3-yaml \
    && rm -rf /var/lib/apt/lists/*

# ── 应用代码 ──
WORKDIR /app
COPY mininet/ /app/mn/
COPY p4/build/ /app/p4/build/
# p4info.env is generated alongside the compiled P4 artifacts in p4/build.
# Do not copy the legacy root-level generated file: it is intentionally
# ignored by Git and made a clean production rebuild fail before Mininet starts.
COPY mininet/topologies/ /app/mn/topologies/
COPY idn-system/config/topology_paths.json /app/config/topology_paths.json
COPY idn-system/config/service_profiles.json /app/config/service_profiles.json
COPY idn-system/config/int_schema.json /app/config/int_schema.json

# default topology name (override via TOPO_NAME env var)
ENV TOPO_NAME=research_dc

ENTRYPOINT []
CMD python3 /app/mn/research_dc_topo.py --onos-ip onos --topo ${TOPO_NAME}
