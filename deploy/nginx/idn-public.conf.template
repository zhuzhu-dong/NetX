# Rendered only on the deployment host by scripts/configure_public_entrypoint.sh.
# __IDN_API_KEY__ is replaced locally from the ignored server .env file and is
# never committed, printed, or embedded in the frontend bundle.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __IDN_PUBLIC_SERVER_NAME__;

    client_max_body_size 2m;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key "__IDN_API_KEY__";
        proxy_read_timeout 180s;
    }

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
